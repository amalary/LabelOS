# Label OS test environment template
# Copy values into your test runner environment as needed. Do not commit real secrets.

NODE_ENV=test
APP_ENV=test
LOG_FORMAT=json
LOG_LEVEL=INFO
SERVICE_NAME=labelos-test
GCP_PROJECT_ID=labelos-test
GOOGLE_CLOUD_PROJECT=labelos-test
CREDENTIAL_STORE_BACKEND=memory
CREDENTIAL_STORE_GCP_PROJECT_ID=
CREDENTIAL_STORE_SECRET_PREFIX=labelos-credential-test
YOUTUBE_OAUTH_CLIENT_ID=client_test_youtube
YOUTUBE_OAUTH_CLIENT_SECRET=secret_test_youtube

# Frontend tests
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_YOUTUBE_DIRECT_OAUTH_ENABLED=false
NEXT_RUNTIME_LOG_LEVEL=INFO

# Backend tests
API_HOST=0.0.0.0
API_PORT=4000
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite+aiosqlite:///:memory:
DATABASE_ECHO=false

# Optional PostgreSQL integration database (must be running).
# Put the real URL in the Git-ignored root .env.test.local file for local pytest.
# Shell/CI TEST_POSTGRES_URL overrides that file; an empty shell value disables it.
# TEST_POSTGRES_URL=postgresql+asyncpg://labelos_test:password@127.0.0.1:55438/labelos_test

# WorkOS-shaped test values only
AUTH_PROVIDER=workos
WORKOS_CLIENT_ID=client_test_placeholder
WORKOS_API_KEY=sk_test_placeholder
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-characters
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_ISSUER_URL=https://api.workos.com
WORKOS_JWKS_URL=https://example.test/workos/jwks
WORKOS_AUDIENCE=
WORKOS_WEBHOOK_SECRET=whsec_test_placeholder
