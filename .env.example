# Label OS environment template
# Copy this file to .env for local development and fill in local values.
# Do not commit real secrets. Production values must be supplied by the host.

# Shared local development
NODE_ENV=development
APP_ENV=local
LOG_FORMAT=json
LOG_LEVEL=info
SERVICE_NAME=labelos-local
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
CREDENTIAL_STORE_BACKEND=memory
CREDENTIAL_STORE_GCP_PROJECT_ID=
CREDENTIAL_STORE_SECRET_PREFIX=labelos-credential
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# Frontend local development
WEB_BASE_URL=http://localhost:3000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_YOUTUBE_DIRECT_OAUTH_ENABLED=false
NEXT_RUNTIME_LOG_LEVEL=info

# Backend local development
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_URL=http://localhost:4000
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000

# Database local development
POSTGRES_DB=labelos
POSTGRES_USER=labelos
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://labelos:replace-with-local-db-password@localhost:5432/labelos
COMPOSE_DATABASE_URL=postgresql+asyncpg://labelos:replace-with-local-db-password@postgres:5432/labelos
DATABASE_ECHO=false

# WorkOS local development
AUTH_PROVIDER=workos
WORKOS_CLIENT_ID=client_replace_with_workos_client_id
WORKOS_API_KEY=sk_replace_with_workos_api_key
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-characters
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_ISSUER_URL=https://api.workos.com
WORKOS_JWKS_URL=
WORKOS_AUDIENCE=
WORKOS_WEBHOOK_SECRET=whsec_replace_when_webhooks_are_enabled

# Agent service local development
AGENTS_HOST=0.0.0.0
AGENTS_PORT=4100
AGENTS_SERVICE_NAME=labelos-agents
AGENTS_LOG_LEVEL=INFO
AGENTS_MODEL_PROVIDER=mock
AGENTS_MODEL_NAME=mock-deterministic
AGENTS_MODEL_TIMEOUT_SECONDS=30
AGENTS_REQUIRE_HUMAN_APPROVAL=true
AGENTS_OPENAI_API_KEY=replace-with-openai-api-key
AGENTS_ANTHROPIC_API_KEY=replace-with-anthropic-api-key
AGENTS_GOOGLE_API_KEY=replace-with-google-api-key

# Scheduling worker (separate entrypoint; no execution enabled by this template)
SCHEDULING_AUTHORING_ENABLED=true
SCHEDULING_EXECUTION_ENABLED=false
SCHEDULING_WORKER_AUTH_MODE=google-oidc
# Configure these only for the private worker service:
# SCHEDULING_WORKER_SERVICE_ACCOUNT_EMAIL=
# SCHEDULING_WORKER_SERVICE_ACCOUNT_SUBJECT=
# SCHEDULING_WORKER_OIDC_AUDIENCE=
# SCHEDULING_WORKER_WORKSPACE_ID=
SCHEDULING_WORKER_BATCH_SIZE=25
SCHEDULING_WORKER_LEASE_SECONDS=120
SCHEDULING_WORKER_LATENESS_SECONDS=300
SCHEDULING_WORKER_TIMEOUT_SECONDS=30
DELIVERY_RECEIVER_BACKEND=unavailable
