# Label OS production environment template
# Do not place real production values in committed files.

NODE_ENV=production
APP_ENV=production
LOG_FORMAT=json
LOG_LEVEL=INFO
SERVICE_NAME=labelos
GCP_PROJECT_ID=<your-gcp-project-id>
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
CREDENTIAL_STORE_BACKEND=gcp-secret-manager
CREDENTIAL_STORE_GCP_PROJECT_ID=<your-gcp-project-id>
CREDENTIAL_STORE_SECRET_PREFIX=labelos-credential
# Configure both YouTube values together before enabling direct OAuth in the web build.
YOUTUBE_OAUTH_CLIENT_ID=<your-google-oauth-web-client-id>
YOUTUBE_OAUTH_CLIENT_SECRET=<set-in-secret-manager-or-runtime-secrets>

# Frontend production
WEB_BASE_URL=https://<your-web-domain>
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://<your-api-domain>
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://<your-web-domain>/api/auth/callback
# Requires Google OAuth Authorized redirect URI:
# https://<your-web-domain>/api/social-account-connections/oauth/youtube/callback
NEXT_PUBLIC_YOUTUBE_DIRECT_OAUTH_ENABLED=false
NEXT_RUNTIME_LOG_LEVEL=INFO

# Backend production
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_URL=https://<your-api-domain>
ALLOWED_FRONTEND_ORIGINS=https://<your-web-domain>
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_ECHO=false

# WorkOS production
AUTH_PROVIDER=workos
WORKOS_CLIENT_ID=client_replace_with_workos_client_id
WORKOS_API_KEY=sk_replace_with_workos_api_key
WORKOS_COOKIE_PASSWORD=replace-with-generated-cookie-password
WORKOS_REDIRECT_URI=https://<your-web-domain>/api/auth/callback
WORKOS_ISSUER_URL=https://api.workos.com
WORKOS_JWKS_URL=
WORKOS_AUDIENCE=
WORKOS_WEBHOOK_SECRET=whsec_replace_when_webhooks_are_enabled

# Agent service production
AGENTS_HOST=0.0.0.0
AGENTS_PORT=4100
AGENTS_SERVICE_NAME=labelos-agents
AGENTS_LOG_LEVEL=INFO
AGENTS_MODEL_PROVIDER=<provider>
AGENTS_MODEL_NAME=<model>
AGENTS_MODEL_TIMEOUT_SECONDS=30
AGENTS_REQUIRE_HUMAN_APPROVAL=true
AGENTS_OPENAI_API_KEY=<set-in-secret-manager-if-used>
AGENTS_ANTHROPIC_API_KEY=<set-in-secret-manager-if-used>
AGENTS_GOOGLE_API_KEY=<set-in-secret-manager-if-used>

# Private scheduling worker; see docs/development/scheduling-worker.md.
# Attach a dedicated runtime service account; these identify its trusted caller.
SCHEDULING_AUTHORING_ENABLED=true
SCHEDULING_EXECUTION_ENABLED=false
SCHEDULING_WORKER_AUTH_MODE=google-oidc
# Worker-service-only values (do not add empty UUID variables to the user API):
# SCHEDULING_WORKER_SERVICE_ACCOUNT_EMAIL=labelos-scheduling-invoker@PROJECT_ID.iam.gserviceaccount.com
# SCHEDULING_WORKER_SERVICE_ACCOUNT_SUBJECT=<numeric-service-account-uniqueId>
# SCHEDULING_WORKER_OIDC_AUDIENCE=https://<canonical-worker-service>.run.app
# SCHEDULING_WORKER_WORKSPACE_ID=<authorized-workspace-uuid>
SCHEDULING_WORKER_BATCH_SIZE=25
SCHEDULING_WORKER_LEASE_SECONDS=120
SCHEDULING_WORKER_LATENESS_SECONDS=300
SCHEDULING_WORKER_TIMEOUT_SECONDS=30
DELIVERY_RECEIVER_BACKEND=unavailable
